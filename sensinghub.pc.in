prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@
protodir=@datadir@/sensinghub/proto

Name: sensing-hub
Description: sensing-hub library (nanopb API)
Version: @PACKAGE_VERSION@
Cflags: -I${includedir}/sensinghub -I${includedir}/sensinghub/nanopb_gen
Libs: -L${libdir} -lsensinghubsession -lqshUtil -lsensinghublogger -lsensinghubapi-c @NANOPB_LIBS@
